APP_DEBUG = false

# Local Docker web port. This repo pins 8086 to avoid colliding with other stacks.
WEB_PORT = 8086

DB_TYPE = mysql
# Docker local mode: db
# Baota/external MySQL mode: server private IP or host.docker.internal
DB_HOST = db
DB_NAME = aimage
DB_USER = root
DB_PASS = change-me
DB_PORT = 3306
# Set to 1 only when using docker-compose.external.yml
AI_WORKFLOW_EXTERNAL_DB = 0
DB_CHARSET = utf8mb4

DEFAULT_LANG = zh-cn

CACHE_DRIVER = redis
CACHE_PREFIX = malulu:
CACHE_EXPIRE = 0

REDIS_HOST = redis
REDIS_PORT = 6379
REDIS_PASSWORD =
REDIS_SELECT = 0
REDIS_TIMEOUT = 2

AI_TEXT_TIMEOUT_SECONDS = 600
AI_TEXT_CONNECT_TIMEOUT_SECONDS = 20
AI_TEXT_MAX_TOKENS = 8192
AI_VIDEO_TIMEOUT_SECONDS = 1200

SUPABASE_URL = https://your-project.supabase.co
SUPABASE_SERVICE_KEY =
SUPABASE_STORAGE_BUCKET = images
SUPABASE_STORAGE_MAX_BYTES = 50000000
QUICK_CREATE_STORAGE_DRIVER = local

# OpenAI-compatible image API used by the default Quick Create image models.
NEWAPI_IMAGE_API_KEY =

; WeChat Pay v3 Native checkout. Set enabled to 1 after credentials and HTTPS are configured.
WECHAT_PAY_ENABLED = 0
WECHAT_PAY_APP_ID =
WECHAT_PAY_MERCHANT_ID =
WECHAT_PAY_MERCHANT_SERIAL_NO =
WECHAT_PAY_API_V3_KEY =
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH =
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID =
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH =
WECHAT_PAY_PLATFORM_CERTIFICATE_PATH =
WECHAT_PAY_NOTIFY_URL = https://your-domain.example/api/payments/wechat/notify
WECHAT_PAY_DESCRIPTION_PREFIX = AI 工作流积分
